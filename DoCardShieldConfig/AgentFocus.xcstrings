    },
    "%@ can wait. You chose this time to focus.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ can wait. You chose this time to focus."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你已暫停使用 %@，讓自己專心完成眼前的事。"
          }
        }
      }
    },
    "Need to end the session? Open DO Card for Emergency Unlock.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Need to end the session? Open DO Card for Emergency Unlock."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如需提前結束，請開啟 DO Card，點選「緊急解鎖」。"
          }
        }
      }
    },
