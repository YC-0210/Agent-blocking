      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CHECKING\nSTATUS."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在確認\n狀態"
          }
        }
