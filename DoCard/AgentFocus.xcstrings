{
  "sourceLanguage": "en",
  "strings": {
    "MEET YOUR\nAGENT.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MEET YOUR\nAGENT."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連結你的\nAI 助理"
          }
        }
      }
    },
    "YOUR APPS.\nYOUR CALL.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "YOUR APPS.\nYOUR CALL."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇讓你\n分心的 App"
          }
        }
      }
    },
    "SET THE\nBOUNDARY.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SET THE\nBOUNDARY."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定\n時間上限"
          }
        }
      }
    },
    "Paste the address and one-time code your agent gave you.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste the address and one-time code your agent gave you."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貼上 AI 助理提供的伺服器網址與一次性配對碼。"
          }
        }
      }
    },
    "Choose which apps and websites your agent can pause.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose which apps and websites your agent can pause."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇專注期間要暫停使用的 App 與網站。"
          }
        }
      }
    },
    "Sessions must fit inside these hours. Change the maximum separately with your agent.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessions must fit inside these hours. Change the maximum separately with your agent."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次專注都必須在允許的時段內結束。之後可請 AI 助理另外調整時間上限。"
          }
        }
      }
    },
    "Connection pending": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection pending"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等待連線中"
          }
        }
      }
    },
    "Agent paired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent paired"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已與 AI 助理配對"
          }
        }
      }
    },
    "One-time setup": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One-time setup"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "首次設定"
          }
