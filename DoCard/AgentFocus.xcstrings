    },
    "Your session status is being checked. Emergency Unlock is available below.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your session status is being checked. Emergency Unlock is available below."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在確認專注狀態。如需立即結束，請點選下方的「緊急解鎖」。"
          }
        }
      }
    },
    "A boundary you chose.\nSpace to get it done.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A boundary you chose.\nSpace to get it done."
