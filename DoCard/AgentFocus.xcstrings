    },
    "FOCUS\nIS ON.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FOCUS\nIS ON."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "專注中"
          }
        }
      }
    },
    "MAKE\nROOM.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MAKE\nROOM."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把時間留給\n重要的事"
          }
        }
